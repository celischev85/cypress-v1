{
  "name": "cypress-v1",
  "version": "1.0.0",
  "description": "E2E tests for Books App",
  "license": "ISC",
  "author": "Dmitry Tselistchev",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "cy:open": "cypress open",
    "cy:open:desktop": "cypress open --config-file cypress.config.js",
    "cy:open:mobile": "cypress open --config-file cypress.mobile.config.js",
    "cy:run:desktop:chrome:headed": "cypress run --config-file cypress.config.js --browser chrome --headed",
    "cy:run:desktop:chrome:headless": "cypress run --config-file cypress.config.js --browser chrome",
    "cy:run:mobile:chrome:headed": "cypress run --config-file cypress.mobile.config.js --browser chrome --headed",
    "cy:run:mobile:chrome:headless": "cypress run --config-file cypress.mobile.config.js --browser chrome",
    "cy:run:desktop:electron:headed": "cypress run --config-file cypress.config.js --headed",
    "cy:run:desktop:electron:headless": "cypress run --config-file cypress.config.js",
    "cy:run:mobile:electron:headed": "cypress run --config-file cypress.mobile.config.js --headed",
    "cy:run:mobile:electron:headless": "cypress run --config-file cypress.mobile.config.js"
  },
  "devDependencies": {
    "cypress": "^16.0.0"
  }
}